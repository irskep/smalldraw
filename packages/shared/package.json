{
  "name": "@smalldraw/shared",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "ts:check": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives . && oxfmt --check .",
    "lint:fix": "oxlint --deny-warnings --report-unused-disable-directives --fix . && oxfmt --write .",
    "test": "bun test --pass-with-no-tests",
    "check": "bun run lint && bun run ts:check && bun run test"
  },
  "exports": {
    ".": "./src/index.ts",
    "./analytics": "./src/webAnalytics.ts"
  }
}
