{
  "name": "@smalldraw/core",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "ts:check": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives . && oxfmt --check .",
    "lint:fix": "oxlint --deny-warnings --report-unused-disable-directives --fix . && oxfmt --write .",
    "test": "bun test --timeout=15000"
  },
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "@automerge/automerge-repo": "2.5.1",
    "@smalldraw/geometry": "workspace:",
    "jittered-fractional-indexing": "^1.0.0",
    "nanoid": "^5.1.6",
    "perfect-freehand": "^1.2.1"
  },
  "devDependencies": {
    "@smalldraw/testing": "workspace:*"
  },
  "imports": {
    "#automerge-wasm": {
      "browser": "./src/wasm.browser.ts",
      "default": "./src/wasm.runtime.ts"
    }
  }
}
