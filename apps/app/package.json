{
  "name": "automerge-jumpstart",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run ts:check && vite build",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives . && oxfmt --check .",
    "lint:fix": "oxlint --deny-warnings --report-unused-disable-directives --fix . && oxfmt --write .",
    "preview": "vite preview",
    "test": "bunx vitest run",
    "ts:check": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "@fontsource-variable/shantell-sans": "5.2.7",
    "@preact/signals": "^2.11.3",
    "@serenity-kit/opaque": "^0.8.4",
    "@smalldraw/core": "workspace:*",
    "@smalldraw/design-system": "workspace:*",
    "@smalldraw/shared": "workspace:*",
    "@smalldraw/splat": "workspace:*",
    "@trpc/client": "^11.8.1",
    "@trpc/server": "11.8.1",
    "lucide": "catalog:ui",
    "preact": "^11.0.1",
    "preact-iso": "^2.12.2",
    "redom": "catalog:ui",
    "vite-plugin-wasm": "^3.5.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/redom": "catalog:ui",
    "happy-dom": "^14.10.1",
    "typescript": "catalog:build",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
