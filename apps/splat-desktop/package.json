{
  "name": "splat-desktop",
  "private": true,
  "scripts": {
    "dev": "bun run ./scripts/run-electrobun.ts build --env=dev && bun run ./scripts/run-electrobun.ts dev --env=dev",
    "build": "bun run ./scripts/run-electrobun.ts build --env=dev",
    "package": "bun run ./scripts/run-electrobun.ts build --env=stable",
    "test": "bun test --pass-with-no-tests",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives . && oxfmt --check .",
    "lint:fix": "oxlint --deny-warnings --report-unused-disable-directives --fix . && oxfmt --write .",
    "ts:check": "tsc -p tsconfig.typecheck.json --noEmit",
    "check": "bun run lint && bun run ts:check && bun run test && bun run build"
  },
  "dependencies": {
    "@smalldraw/splat": "workspace:*",
    "electrobun": "1.14.4"
  }
}
