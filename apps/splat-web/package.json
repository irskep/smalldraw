{
  "name": "splat-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run ./scripts/build.ts",
    "dev": "bun --watch scripts/dev.ts",
    "serve": "bunx serve dist",
    "test": "bun test --timeout 4000 --pass-with-no-tests",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives . && oxfmt --check .",
    "lint:fix": "oxlint --deny-warnings --report-unused-disable-directives --fix . && oxfmt --write .",
    "ts:check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@smalldraw/shared": "workspace:*",
    "@smalldraw/splat": "workspace:*"
  }
}
