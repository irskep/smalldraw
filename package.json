{
  "name": "automerge-apps-monorepo",
  "private": true,
  "catalogs": {
    "build": {
      "tsup": "^9.0.0",
      "typescript": "npm:@typescript/typescript6@^6.0.2"
    },
    "testing": {
      "@playwright/test": "^1.55.1",
      "happy-dom": "^14.10.1"
    },
    "ui": {
      "@types/redom": "^3.2.4",
      "lucide": "^1.17.0",
      "open-props": "^1.7.23",
      "redom": "^3.27.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "scripts": {
    "ts:check": "bun --filter '*' ts:check",
    "test": "bun --filter '*' test",
    "lint": "bun --filter '*' lint",
    "format": "bun run format:check",
    "format:check": "bunx biome format .",
    "format:fix": "bunx biome format --write .",
    "fix:all": "bun run format:fix && bun --filter '*' lint:fix"
  },
  "overrides": {
    "@typescript/old": "https://registry.npmjs.org/typescript/-/typescript-6.0.2.tgz"
  },
  "patchedDependencies": {
    "@automerge/automerge-repo@2.5.1": "patches/@automerge%2Fautomerge-repo@2.5.1.patch"
  }
}
