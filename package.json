{
  "name": "automerge-apps-monorepo",
  "private": true,
  "catalogs": {
    "build": {
      "typescript": "7.1.0-beta"
    },
    "testing": {
      "@playwright/test": "^1.55.1",
      "happy-dom": "^14.10.1"
    },
    "ui": {
      "@types/redom": "^3.2.4",
      "lucide": "^1.17.0",
      "open-props": "^1.7.23",
      "redom": "^3.27.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "pacwich": "0.7.3",
    "typescript": "catalog:build"
  },
  "scripts": {
    "ts:check": "bun run --filter '*' ts:check",
    "test": "pacwich run test --parallel=4",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives . && oxfmt --check .",
    "format": "bun run format:check",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "fix:all": "bun run format:fix && oxlint --fix --deny-warnings .",
    "preinstall": "bun run scripts/check-bun-version.ts",
    "check": "bun run scripts/check-workspaces.ts",
    "check:all": "bun run scripts/check-workspaces.ts --all"
  },
  "patchedDependencies": {
    "@automerge/automerge-repo@2.5.1": "patches/@automerge%2Fautomerge-repo@2.5.1.patch"
  }
}
